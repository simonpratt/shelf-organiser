# Where shelf.db lives. The image sets /data.
DATA_DIR=/data
# Listen port. The image sets 8080.
PORT=8080
# Test only: mounts POST /api/test/reset, which empties the database. Never set in production.
APP_TEST_MODE=0
# Optional: an Anthropic API key turns on dictation and tag proposals (Claude drafts items and proposes Type tags).
# Leave empty for typed entry only.
ANTHROPIC_API_KEY=
# Optional, normally empty: another address for the Anthropic API (the e2e suite points it at a fake).
ANTHROPIC_BASE_URL=
# Optional: a username and password turn on the login page; set both, or neither for no login
# (only on a trusted network). Changing either logs every browser out.
APP_USERNAME=
APP_PASSWORD=
